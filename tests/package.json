{
  "name": "dailyred-tests",
  "private": true,
  "type": "module",
  "description": "Headless browser tests for Daily Red (drives your installed Google Chrome)",
  "scripts": {
    "test": "node smoke.mjs && node site.mjs",
    "smoke": "node smoke.mjs",
    "site": "node site.mjs",
    "teams": "node teams.mjs",
    "bilingual:es": "node bilingual.mjs es",
    "bilingual:en": "node bilingual.mjs en",
    "localization": "node ../scripts/localize-rom.mjs --check",
    "security": "node security.mjs",
    "toolbar": "node toolbar.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
